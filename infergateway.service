# File path: /etc/systemd/system/infergateway.service
# sudo systemctl daemon-reload
# sudo systemctl start infergateway
# sudo systemctl enable infergateway
# sudo systemctl status infergateway
[Unit]
Description=InferGateway Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/infergateway  # 注意修改路径
ExecStart=/path/to/infergateway/infergateway --port 3000 --log-dir /path/to/infergateway/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
